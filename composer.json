{
  "name": "mitwork/kalkan",
  "description": "Signing, validations digital signature with kalkan (NCALayer, NCANode)",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Eugene Kozlov",
      "email": "eudjin@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3|^8.4|^8.5",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-dom": "*",
    "ext-libxml": "*",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/events": "^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.8.2|^8.1.0",
    "endroid/qr-code": "^6.0"
  },
  "require-dev": {
    "khanamiryan/qrcode-detector-decoder": "^2.0",
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^2.1.6",
    "phpunit/phpunit": "^11.5.3|^12.5.8|^13.3.2",
    "symfony/yaml": "^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Mitwork\\Kalkan\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mitwork\\Kalkan\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Mitwork\\Kalkan\\KalkanServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  }
}
